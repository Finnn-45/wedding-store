# --- Key formats ---------------------------------------------------------
# Supabase now issues two key types (Project Settings -> API Keys):
#   publishable  sb_publishable_...  -> NEXT_PUBLIC_SUPABASE_ANON_KEY
#   secret       sb_secret_...       -> SUPABASE_SERVICE_ROLE_KEY
# The legacy `anon` and `service_role` JWTs (eyJ...) still work, but Supabase
# deprecates them at the end of 2026. Neither new key is a JWT: send them on
# the `apikey` header only.
#
# Copy this file to .env.local and fill in real values. A secret key bypasses
# RLS: never prefix it with NEXT_PUBLIC_, never commit it, never log it.
# Verify the whole connection at any time with:  npm run db:check
#
# NOTE: the app leaves mock mode as soon as the two public values below are
# present, so either fill them with a real project or leave no .env.local.

# --- Supabase (public, browser-safe) -------------------------------------
# Project URL and the anon/publishable key. These two are embedded in the
# client bundle by design; every query they make is subject to RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase (privileged, SERVER ONLY) ---------------------------------
# The service_role key bypasses RLS. It must NEVER be prefixed with
# NEXT_PUBLIC_, never imported by a client component, and never returned in a
# response. Without it, order writes, delivery assets, signed URLs and the
# admin area are all disabled.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=hello@blancweddings.com

# --- Checkout ------------------------------------------------------------
# The only payment service wired in is a MOCK that marks every order paid and
# issues the paid files. In a production build (Vercel) checkout is refused
# with 503 payments_disabled unless this is explicitly "true". Keep it unset
# for real deployments; set it only to demo the full purchase flow on your
# own staging URL. npm run dev always allows mock checkout, flag or not.
# ENABLE_MOCK_CHECKOUT=true